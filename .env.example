# Copy to `.env` (git-ignored) and fill in. Real environment variables take precedence over this file.
# NEVER commit the real file or paste its contents into a chat or issue.

# Angel One SmartAPI (read-only use: login + historical candles)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
# the TOTP *secret* (long base32 key from enrolment), not the 6-digit code
ANGEL_TOTP=

# PostgreSQL (or set PATTERNIQ_DB_URL instead)
PG_USER=
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=prism
